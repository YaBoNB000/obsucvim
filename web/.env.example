# 网易 163 邮箱验证码 SMTP
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_USER=obsucvim@163.com
SMTP_FROM=obsucvim@163.com
# 在服务器私密环境变量中设置 163 邮箱客户端授权码，切勿提交
SMTP_PASS=

# Set exact proxy peer IPs when TLS is terminated in a reverse proxy.
# The Windows launcher defaults to loopback; only listed peers may supply X-Forwarded-For.
OBSUCVIM_TRUSTED_PROXY_IPS=127.0.0.1,::1

# Optional emergency override: set to 1 only when the public site is HTTPS-only.
# Normally HTTPS is detected from the socket or X-Forwarded-Proto of a trusted proxy.
OBSUCVIM_COOKIE_SECURE=

# Optional Cloudflare Turnstile (both keys required; values are set in the server environment).
# If neither key is set, the local slider CAPTCHA remains active; a partial pair fails closed.
CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=
CLOUDFLARE_TURNSTILE_HOSTNAME=obsucvim.l2.ink
